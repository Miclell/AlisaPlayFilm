<Project>
    <PropertyGroup>
        <!-- По умолчанию используем net9.0-windows для разработки на Windows -->
        <!-- Но если TargetFrameworkOverride установлен (передается через /p:), используем его -->
        <_DefaultTargetFramework>net9.0-windows</_DefaultTargetFramework>
        <TargetFramework Condition="'$(TargetFrameworkOverride)' != ''">$(TargetFrameworkOverride)</TargetFramework>
        <TargetFramework Condition="'$(TargetFrameworkOverride)' == ''">$(_DefaultTargetFramework)</TargetFramework>
        
        <!-- Если TargetFrameworkOverride не установлен, но указан RuntimeIdentifier, переключаемся автоматически -->
        <TargetFramework Condition="'$(TargetFrameworkOverride)' == '' AND '$(RuntimeIdentifier)' == 'linux-x64'">net9.0</TargetFramework>
        <TargetFramework Condition="'$(TargetFrameworkOverride)' == '' AND '$(RuntimeIdentifier)' == 'osx-x64'">net9.0</TargetFramework>
        <TargetFramework Condition="'$(TargetFrameworkOverride)' == '' AND '$(RuntimeIdentifier)' == 'osx-arm64'">net9.0</TargetFramework>
        
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <PublishSingleFile>true</PublishSingleFile>
        <SelfContained>true</SelfContained>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
    </PropertyGroup>
</Project>